# Copia este fichero como `.env` y rellena lo que uses.
# prospector.py lo carga solo; las variables ya definidas en el entorno mandan.
#
# NADA de esto es obligatorio: sin ninguna clave, el script funciona igual
# usando OpenStreetMap como fuente.

# Solo si quieres --fuente google (mejores datos, requiere facturación activa)
GOOGLE_PLACES_API_KEY=

# Solo si quieres --usar-ia (mensajes escritos por Claude)
ANTHROPIC_API_KEY=

# Opcional: email de contacto para identificarte ante las APIs de OSM.
# Es buena educación si vas a hacer muchas búsquedas.
NOMINATIM_CONTACT=
